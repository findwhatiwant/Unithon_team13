# Copy this file to .env for local development.
# Do not commit real keys.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Local server defaults
REFINER_API_HOST=127.0.0.1
REFINER_API_PORT=8000

# Windows app remote deployment mode
# Set this to your deployed API URL, for example https://magic-note.example.com
REFINER_API_BASE_URL=http://127.0.0.1:8000

# Set to 1 when the Windows app must never start a local FastAPI server.
REFINER_DISABLE_LOCAL_SERVER=0

# Optional: use when the React frontend is hosted on a different origin from FastAPI.
# REFINER_FRONTEND_BASE_URL=https://magic-note-frontend.example.com
# REFINER_CORS_ORIGINS=https://magic-note-frontend.example.com

# Optional: used only when building the React app separately from FastAPI.
# VITE_REFINER_API_BASE_URL=https://your-deployed-api.example.com
